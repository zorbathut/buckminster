# VS local directory
.vs

# Rider local directory
.idea

# User settings
*.csproj.user
*.sln.DotSettings.user

# Built assets (C#)
**/bin
**/obj

# Built assets (Rust)
/src/target

# Tools venv (rebuilt by tools/lib/bootstrap.py)
/tools/lib/.venv

# Python bytecode caches
__pycache__/
*.pyc

# Claude local settings
**/.claude/settings.local.json

# FFI codegen output: build artifacts regenerated by ./tool.bat build (the build-codegen step), never checked in. Any Generated/ dir under any module's C# tree is codegen-owned by convention (ffigen's _CRATES table says which exist).
src/*/cs/**/Generated/
