<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Run via the NUnit Microsoft.Testing.Platform runner, not legacy VSTest. The MTP opt-in must live in global.json's "test" key: the .NET 10 SDK removed the per-project VSTest bridge (TestingPlatformDotnetTestSupport errors at build), so there is no project-owned alternative. -->
        <EnableNUnitRunner>true</EnableNUnitRunner>
        <!-- delegate* unmanaged function pointers in the FFI tests. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../core/cs/Buckminster.Core.csproj" />
        <ProjectReference Include="../../general/cs/Buckminster.General.csproj" />
        <ProjectReference Include="../../usergame-demo/cs/Buckminster.Usergame.Demo.csproj" />
    </ItemGroup>

    <!-- Generated/ holds build artifacts (gitignored, emitted by the build-codegen step; the per-struct layout tests live there); fail loud and instructive when the tool hasn't run, same precedent as Core's native-library and generated-bindings checks. -->
    <Target Name="BuckCheckGenerated" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="!Exists('Generated/LayoutTests.g.cs')" Text="Generated test sources not found under Generated; run './tool.bat build' (the codegen step emits them) before building the .NET solution." />
    </Target>

</Project>
