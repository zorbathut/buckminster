<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- The LibraryImport source generator refuses to run without unsafe permission (SYSLIB1062), pointer-bearing signatures or not. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../core/cs/Buckminster.Core.csproj" />
        <ProjectReference Include="../../usergame-demo/cs/Buckminster.Usergame.Demo.csproj" />
    </ItemGroup>

    <!-- Same precedent as core's BuckCheckGenerated: this project's Generated/ dir holds build artifacts (gitignored, regenerated by the build-codegen step), so a bare dotnet build on a clean checkout gets an instructive message instead of missing-type errors. -->
    <Target Name="BuckCheckGenerated" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="!Exists('Ffi/Generated/NativeMethods.g.cs')" Text="Generated FFI bindings not found under Ffi/Generated -- run './tool.bat build' (the codegen step emits them) before building the .NET solution." />
    </Target>

</Project>
