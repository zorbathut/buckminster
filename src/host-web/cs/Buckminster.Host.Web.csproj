<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

    <!-- The browser host. Project shape follows the wasmbrowser template (.NET 10): the WebAssembly SDK implies browser-wasm + Exe; the placeholder/fingerprint bits are how the template wires index.html to the built assets. -->
    <Import Project="../../WasmHost.props" />

    <PropertyGroup>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <!-- The [JSExport] source generator emits unsafe code (SYSLIB1075 makes this mandatory, not stylistic). -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../stdcs/cs/Buckminster.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The M3 test matrix: the same test sources dotnet test runs natively, compiled INTO this host (linked sources, not a ProjectReference to the MTP exe, which would drag the test-platform assemblies into a wasm AppBundle they can't run in). InternalsVisibleTo already covers this assembly. -->
        <Compile Include="../../stdcs/tests/**/*.cs" Exclude="../../stdcs/tests/obj/**;../../stdcs/tests/bin/**" Link="Tests/%(Filename)%(Extension)" />
        <PackageReference Include="NUnit" Version="4.6.1" />
    </ItemGroup>

</Project>
