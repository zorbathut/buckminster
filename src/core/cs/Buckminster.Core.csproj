<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- delegate* unmanaged function pointers in the FFI bindings. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- cargo builds the debug profile today; profile selection becomes a property when a release path exists. Host-OS conditional: cargo names the cdylib libbuckminster_core.so on Linux and buckminster_core.dll on Windows (DllImport("buckminster_core") resolves both); macOS (.dylib) waits for the mac target. -->
        <BuckNativeLibrary>../../target/debug/libbuckminster_core.so</BuckNativeLibrary>
        <BuckNativeLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">../../target/debug/buckminster_core.dll</BuckNativeLibrary>
    </PropertyGroup>

    <ItemGroup>
        <!-- Raw FFI stays internal, never public API; tests reach it through these. The wasm host entries exist because the test sources are glob-compiled INTO those host assemblies, so internals-touching fixtures run under the hosts' identities. -->
        <InternalsVisibleTo Include="Buckminster.Tests" />
        <InternalsVisibleTo Include="Buckminster.Host.Web" />
        <InternalsVisibleTo Include="Buckminster.Host.WasmNode" />
        <!-- None + CopyToOutputDirectory flows transitively through ProjectReference, so test and host projects get the native library with no wiring of their own. -->
        <None Include="$(BuckNativeLibrary)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>

    <!-- Loud, instructive failure when cargo hasn't run, instead of MSBuild's cryptic missing-file copy error. Skipped for IDE design-time builds so project load on a clean checkout doesn't half-fail with the message buried. -->
    <Target Name="BuckCheckNativeLibrary" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="!Exists('$(BuckNativeLibrary)')" Text="Native library not found at $(BuckNativeLibrary) -- run './tool.bat build' (or 'cargo build' with cwd src/) before building the .NET solution." />
    </Target>

</Project>
